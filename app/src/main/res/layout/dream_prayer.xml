<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.raafi.cyberhome.DreamBackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="32dp"
        android:paddingEnd="56dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/dreamHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dream_dot" />

            <TextView
                android:id="@+id/sceneLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.3"
                android:text="JADWAL SHOLAT"
                android:textColor="@color/dream_text"
                android:textSize="11sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/scenePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dream_pill"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.2"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="LOKASI ANDA"
                android:textColor="@color/dream_white"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/clockBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="15:26"
                android:textColor="@color/dream_white"
                android:textSize="104sp" />

            <TextView
                android:id="@+id/gregorian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:text="Minggu, 25 Oktober 2026"
                android:textColor="@color/dream_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/hijri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="14 Jumadil Awal 1448 H"
                android:textColor="@color/dream_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/sceneHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/prayerScene"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/countdownPill"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_dream_countdown"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="28dp">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dream_dot" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/countdownLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.24"
                            android:text="MENUJU MAGHRIB"
                            android:textColor="#9CC8FF"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/countdownValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.02"
                            android:text="02 : 21 : 09"
                            android:textColor="@color/dream_white"
                            android:textSize="26sp" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/prayerStrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal" />

                <com.raafi.cyberhome.PrayerProgressView
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/notesScene"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/notesGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/notesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_dream_empty"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="+"
                        android:textColor="#9CC8FF"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="Belum ada catatan"
                        android:textColor="@color/dream_white"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="Tambahkan dari halaman Layar di web."
                        android:textColor="@color/dream_dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/todoScene"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/todoSummaryRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/todoSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.18"
                        android:text="3 TUGAS TERSISA"
                        android:textColor="#9CC8FF"
                        android:textSize="10sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/todoPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.14"
                        android:text="2 / 5 SELESAI"
                        android:textColor="@color/dream_dim"
                        android:textSize="10sp" />
                </LinearLayout>

                <com.raafi.cyberhome.PrayerProgressView
                    android:id="@+id/todoProgress"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:id="@+id/todoGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/todoEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_dream_empty"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="✓"
                        android:textColor="#9CC8FF"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="Belum ada tugas"
                        android:textColor="@color/dream_white"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="Tambahkan to-do dari halaman Layar di web."
                        android:textColor="@color/dream_dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/footerHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="10dp"
        android:alpha="0.55"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.14"
        android:text="Tekan tombol apa pun untuk keluar"
        android:textColor="@color/dream_dim"
        android:textSize="9sp" />
</FrameLayout>
